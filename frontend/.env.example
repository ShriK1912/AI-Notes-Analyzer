# ─────────────────────────────────────────────────────────────────
# AskMyNotes — Frontend Environment Variables
# Copy this file to .env and fill in the real values
# ─────────────────────────────────────────────────────────────────

# ── Firebase Config ───────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Your Apps → Web App → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Get after linking Google Analytics: Firebase Console → Project Settings → Integrations
VITE_FIREBASE_MEASUREMENT_ID=

# ── Backend URL ───────────────────────────────────────────────────
# Local development:
VITE_API_URL=http://localhost:8000/api/v1
# Production (replace with your Render URL):
# VITE_API_URL=https://askmynotes-backend.onrender.com/api/v1

# ── Firebase App Check (reCAPTCHA v3) ────────────────────────────
# Get from: google.com/recaptcha/admin/create → Score based (v3)
# Add domains: localhost, ai-notes-analyser.web.app, ai-notes-analyser.firebaseapp.com
VITE_RECAPTCHA_V3_SITE_KEY=

# Set to "true" only during LOCAL development to bypass App Check enforcement.
# The debug token UUID will appear in the browser DevTools console on first load.
# Register that UUID in Firebase Console → App Check → Debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=false
