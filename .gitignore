# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Firebase and Google Cloud credentials (NEVER COMMIT)
backend/firebase-service-account.json
*service-account*.json
*.json.bak

# Environment variable files (NEVER COMMIT)
*.env
*.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# Dependencies and virtual environments
node_modules/
frontend/node_modules/
.venv/
venv/
backend/venv/

# Build outputs
dist/
frontend/dist/
.dist/
build/
.firebase/

# Local databases and logs
chroma_db/
backend/chroma_db/
logs/
*.log
backend/*.log
